    id          INTEGER PRIMARY KEY AUTOINCREMENT,
    file_path   TEXT    NOT NULL,          -- relative path, e.g. genres/blues/blues.00000.wav
    label       TEXT    NOT NULL,          -- genre string: blues, jazz, rock, etc.
    label_id    INTEGER NOT NULL,          -- integer encoding of the label (0–9)
    split       TEXT    NOT NULL           -- 'train', 'val', or 'test'
                CHECK(split IN ('train','val','test')),
    duration_s  REAL,                      -- clip duration in seconds (from EDA)
    sample_rate INTEGER,                   -- sample rate confirmed during cleaning
    is_valid    INTEGER DEFAULT 1          -- 1 = usable, 0 = quarantined/corrupt
);</sql><current_tab id="0"/></tab_sql></sqlb_project>
